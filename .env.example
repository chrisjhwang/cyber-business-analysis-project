# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# NVD CVE API 2.0 key (optional). Without it ingestion is rate-limited to
# 5 requests/30s; with it, 50 requests/30s.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Connection string used by the app/Alembic from the host machine.
# Must match the docker-compose postgres credentials below. (Inside compose,
# docker-compose.yml overrides this to point at host "db" instead.)
# If the password contains URL-special characters (@ : / %), URL-encode them.
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/cyber_risk

# Consumed by docker-compose to provision the local Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cyber_risk
POSTGRES_PORT=5432
